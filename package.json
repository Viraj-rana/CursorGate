{
  "name": "cursor-gate",
  "displayName": "CursorGate — Sync & Share Cursor AI Chats",
  "description": "Sync and share Cursor AI chat history across devices using your private GitHub repo. Free, serverless backup for Cursor conversations — no third-party servers.",
  "version": "0.1.1",
  "publisher": "viraj",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B1020",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Viraj-rana/CursorGate.git"
  },
  "bugs": {
    "url": "https://github.com/Viraj-rana/CursorGate/issues"
  },
  "homepage": "https://github.com/Viraj-rana/CursorGate#readme",
  "qna": "https://github.com/Viraj-rana/CursorGate/issues",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Education"
  ],
  "keywords": [
    "cursor",
    "cursor ai",
    "cursor chat",
    "cursor sync",
    "chat history",
    "ai chat",
    "share chat",
    "sync chats",
    "github backup",
    "private github",
    "composer",
    "agent chat",
    "conversation backup",
    "multi device",
    "cursorgate",
    "vscode",
    "ai coding"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:cursorGate.sidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursor-gate",
          "title": "CursorGate",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cursor-gate": [
        {
          "id": "cursorGate.sidebar",
          "name": "Chat Gate"
        }
      ]
    },
    "commands": [
      {
        "command": "cursorGate.connect",
        "title": "CursorGate: Connect GitHub",
        "category": "CursorGate"
      },
      {
        "command": "cursorGate.syncNow",
        "title": "CursorGate: Sync Now",
        "category": "CursorGate"
      },
      {
        "command": "cursorGate.shareChat",
        "title": "CursorGate: Share Selected Chat",
        "category": "CursorGate"
      },
      {
        "command": "cursorGate.refresh",
        "title": "CursorGate: Refresh Status",
        "category": "CursorGate"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  }
}
